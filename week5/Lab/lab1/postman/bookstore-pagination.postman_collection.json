      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=cursor&limit=5&cursor={{nextCursor}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "books"],
          "query": [
            {"key": "strategy", "value": "cursor"},
            {"key": "limit", "value": "5"},
            {"key": "cursor", "value": "{{nextCursor}}"}
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Page 2 returns 5 items and valid next_cursor', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.length).to.eql(5);",
              "    pm.expect(json.page_info.has_more).to.be.a('boolean');",
              "    if (json.page_info.has_more) {",
              "        pm.collectionVariables.set('nextCursor', json.page_info.next_cursor);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Genre Filtering - Tech Books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=offset&genre=tech&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "books"],
          "query": [
            {"key": "strategy", "value": "offset"},
            {"key": "genre", "value": "tech"},
            {"key": "limit", "value": "20"}
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('All returned books belong to tech genre', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.length).to.be.above(0);",
              "    json.data.forEach(function(book) {",
              "        pm.expect(book.category.slug).to.eql('tech');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Multi-Key Sorting - Price DESC, Title ASC",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=offset&sort=-price,title&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "books"],
          "query": [
            {"key": "strategy", "value": "offset"},
            {"key": "sort", "value": "-price,title"},
            {"key": "limit", "value": "10"}
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Books are sorted descending by price then title', function () {",
              "    var json = pm.response.json();",
              "    for (var i = 0; i < json.data.length - 1; i++) {",
              "        var curr = json.data[i];",
              "        var next = json.data[i+1];",
              "        if (curr.price === next.price) {",
              "            pm.expect(curr.title <= next.title).to.be.true;",
              "        } else {",
              "            pm.expect(curr.price).to.be.above(next.price);",
              "        }",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
