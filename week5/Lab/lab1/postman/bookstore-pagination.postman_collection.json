{
  "info": {
    "_postman_id": "a98e2173-8d07-4c54-93fa-d6f7881bc09e",
    "name": "Flask Bookstore API - Pagination & Filtering",
    "description": "Comprehensive Postman test collection for Flask Bookstore API verifying Offset Pagination, Cursor/Keyset Pagination, Multi-key Sorting, Genre Filtering, Tampering Protection, Error Handling, and CRUD regression.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "nextCursor",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdBookId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Offset Pagination - Defaults (limit=20, offset=0)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "books"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response structure has data and pagination', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('data');",
              "    pm.expect(json).to.have.property('pagination');",
              "    pm.expect(json.pagination.strategy).to.eql('offset');",
              "    pm.expect(json.pagination.offset).to.eql(0);",
              "    pm.expect(json.pagination.limit).to.eql(20);",
              "    pm.expect(json.pagination.total).to.be.at.least(20);",
              "    pm.expect(json.pagination.has_next).to.be.a('boolean');",
              "    pm.expect(json.data.length).to.be.at.most(20);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Offset Pagination - Explicit offset and limit (Page 2)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=offset&offset=10&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "books"],
          "query": [
            {"key": "strategy", "value": "offset"},
            {"key": "offset", "value": "10"},
            {"key": "limit", "value": "10"}
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Pagination metadata matches offset=10 limit=10', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.pagination.offset).to.eql(10);",
              "    pm.expect(json.pagination.limit).to.eql(10);",
              "    pm.expect(json.data.length).to.eql(10);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Cursor Pagination - Page 1 (limit=5)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=cursor&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "books"],
          "query": [
            {"key": "strategy", "value": "cursor"},
            {"key": "limit", "value": "5"}
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has page_info and next_cursor', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('data');",
              "    pm.expect(json).to.have.property('page_info');",
              "    pm.expect(json.page_info.has_more).to.eql(true);",
              "    pm.expect(json.page_info.next_cursor).to.be.a('string');",
              "    pm.collectionVariables.set('nextCursor', json.page_info.next_cursor);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
